{{page-title this.pageTitle}}

<h1>{{this.model.name}}</h1>
<p class="space-system-desc">{{this.model.description}}</p>

<div class="space-system-toolbar">
  <button class="btn btn-sm btn-secondary" {{action "refresh"}}>Refresh</button>
  <button class="btn btn-sm btn-secondary" {{action "toggleAnimation"}}>
    {{if this.animate "Pause orbits" "Resume orbits"}}
  </button>
  {{#if this.model.own_ship}}
    <span class="space-own-ship">
      {{this.model.own_ship.name}}:
      {{#if this.model.own_ship.in_transit}}
        under way to {{this.model.own_ship.destination_name}}, ETA {{this.model.own_ship.eta}}
      {{else}}
        holding at {{this.model.own_ship.location_name}}
      {{/if}}
    </span>
  {{/if}}
</div>

<div class="row">
  <div class="col-lg-8">
    <SpaceSystemMap
      @system={{this.model}}
      @selectedKey={{this.selectedKey}}
      @animate={{this.animate}}
      @onSelect={{action "selectBody"}} />
  </div>

  <div class="col-lg-4">
    {{#if this.selectedBody}}
      <h3>{{this.selectedBody.name}}</h3>
      <p class="space-body-meta">
        {{this.selectedBody.classification}} &middot; ring {{this.selectedBody.ring}}
        &middot; held by <strong>{{this.selectedBody.faction}}</strong>
      </p>
      {{#if this.selectedBody.description}}
        <p>{{this.selectedBody.description}}</p>
      {{/if}}

      {{#if this.selectedBody.ships.length}}
        <h4>Present</h4>
        <ul class="space-body-ships-list">
          {{#each this.selectedBody.ships as |name|}}<li>{{name}}</li>{{/each}}
        </ul>
      {{/if}}

      {{#if this.selectedBody.engaged}}
        <p class="space-body-engaged-note">
          Engagement in progress, round {{this.selectedBody.round}}.
          <LinkTo @route="space-tactical" @model={{this.selectedBody.sector_id}}>
            Open tactical plot
          </LinkTo>
        </p>
      {{/if}}

      {{#if this.model.own_ship}}
        <button class="btn btn-sm btn-primary"
                {{action "travelTo" this.selectedBody.key}}>
          Set course for {{this.selectedBody.name}}
        </button>
      {{/if}}
    {{else}}
      <p class="space-system-hint">Select a body on the map for detail.</p>
    {{/if}}

    <h4>Bodies</h4>
    <table class="table table-sm space-body-table">
      <tbody>
        {{#each this.model.bodies as |body|}}
          <tr class="{{if body.engaged 'space-row-engaged'}}">
            <td>{{body.ring}}</td>
            <td>{{body.name}}</td>
            <td>{{body.faction}}</td>
            <td>{{#if body.ships.length}}{{body.ships.length}}{{/if}}</td>
          </tr>
        {{/each}}
      </tbody>
    </table>
  </div>
</div>
