{{page-title this.pageTitle}}

<h1>{{this.model.name}}</h1>

<div class="space-tac-status">
  <span class="space-tac-geometry">{{this.model.geometry}}</span>
  {{#if this.model.in_combat}}
    <span class="space-tac-round">Round {{this.model.round}}</span>
  {{else}}
    <span class="space-tac-quiet">No engagement running</span>
  {{/if}}
  <button class="btn btn-sm btn-secondary" {{action "refresh"}}>Refresh</button>
</div>

<div class="row">
  <div class="col-lg-8">
    <SpacePlot
      @sector={{this.model}}
      @ownShip={{this.model.own_ship}}
      @contacts={{this.model.contacts}}
      @terrain={{this.model.terrain}}
      @selectedId={{this.selectedTargetId}}
      @onSelect={{action "selectTarget"}} />

    {{#if this.roundLog}}
      <h3>Last Round</h3>
      <pre class="space-round-log"><AnsiFormat @text={{this.roundLog}} /></pre>
    {{/if}}
  </div>

  <div class="col-lg-4">

    {{#if this.model.own_ship}}
      <h3>{{this.model.own_ship.name}}</h3>
      <p class="space-own-summary">
        {{this.model.own_ship.ship_class}} &mdash; heading
        {{this.model.own_ship.facing_name}}, speed {{this.model.own_ship.speed}}
        at {{this.model.own_ship.x}},{{this.model.own_ship.y}}
      </p>

      <table class="table table-sm space-sections">
        <thead>
          <tr><th>Section</th><th>Shields</th><th>Hull</th><th>Systems</th></tr>
        </thead>
        <tbody>
          {{#each this.model.own_ship.sections as |s|}}
            <tr class="{{if s.destroyed 'space-section-destroyed'}}">
              <td>{{s.name}}</td>
              <td>{{s.shields}}/{{s.max_shields}}</td>
              <td>{{s.hull}}/{{s.max_hull}}</td>
              <td>
                {{#if s.systems.length}}
                  {{#each s.systems as |sys|}}<span class="space-system">{{sys}}</span>{{/each}}
                {{else}}&mdash;{{/if}}
              </td>
            </tr>
          {{/each}}
        </tbody>
      </table>

      <p class="space-strain">
        Strain {{this.model.own_ship.strain}}/{{this.model.own_ship.strain_threshold}}
        {{#if this.model.own_ship.strained_out}}
          <span class="space-adrift">ADRIFT</span>
        {{/if}}
      </p>

      <h4>Orders</h4>

      <div class="space-order-block">
        <label>Heading</label>
        <div class="space-heading-row">
          {{#each this.model.facings as |f|}}
            <button class="btn btn-sm {{if (eq f this.heading) 'btn-primary' 'btn-outline-secondary'}}"
                    {{action (mut this.heading) f}}>{{f}}</button>
          {{/each}}
        </div>
        <label>Speed</label>
        <Input @type="number" @value={{this.speed}} class="form-control form-control-sm"
               min="0" max={{this.model.own_ship.max_speed}} />
        <button class="btn btn-sm btn-primary" {{action "orderHelm"}}>Come About</button>
        <button class="btn btn-sm btn-secondary" {{action "orderEvade"}}>Evade</button>
        <button class="btn btn-sm btn-secondary" {{action "orderHold"}}>Hold</button>
      </div>

      <div class="space-order-block">
        <label>Weapons</label>
        {{#if this.selectedTargetName}}
          <p class="space-target">Target: <strong>{{this.selectedTargetName}}</strong></p>
        {{else}}
          <p class="space-target space-target-none">Click a contact on the plot to target it.</p>
        {{/if}}

        {{#each this.model.own_ship.hardpoints as |hp|}}
          <button class="btn btn-sm {{if (eq hp.index this.selectedHardpoint) 'btn-primary' 'btn-outline-secondary'}}"
                  {{action "setHardpoint" hp.index}}>
            [{{hp.index}}] {{hp.weapon}} ({{hp.arc}}{{#if hp.ammo}}, ammo {{hp.ammo}}{{/if}})
          </button>
        {{/each}}

        <button class="btn btn-sm btn-danger" {{action "orderFire"}}>Fire</button>
      </div>

      <div class="space-order-block">
        <label>Damage Control</label>
        {{#each this.model.own_ship.sections as |s|}}
          <button class="btn btn-sm {{if (eq s.name this.repairSection) 'btn-primary' 'btn-outline-secondary'}}"
                  {{action (mut this.repairSection) s.name}}>{{s.name}}</button>
        {{/each}}
        <button class="btn btn-sm btn-secondary" {{action "orderRepair"}}>Repair</button>
        <button class="btn btn-sm btn-secondary" {{action "orderVent"}}>Vent Strain</button>
        <button class="btn btn-sm btn-secondary" {{action "orderSweep"}}>Sensor Sweep</button>
        <button class="btn btn-sm btn-link" {{action "clearOrders"}}>Clear Orders</button>
      </div>
    {{else}}
      <p class="space-no-ship">
        {{#if this.model.gm_view}}
          Staff view: showing the whole sector rather than one ship's sensors.
        {{else}}
          You aren't crewing a ship in this sector.
        {{/if}}
      </p>
    {{/if}}

    <h4>Contacts</h4>
    {{#if this.model.contacts.length}}
      <table class="table table-sm space-contacts">
        <tbody>
          {{#each this.model.contacts as |c|}}
            <tr class="{{unless c.identified 'space-contact-unknown'}}">
              <td>{{if c.identified c.name "UNKNOWN"}}</td>
              <td>{{c.faction}}</td>
              <td>{{c.bearing_name}} {{c.distance}}</td>
              <td>
                {{#if c.identified}}S {{c.shields}}/{{c.max_shields}} H {{c.hull}}/{{c.max_hull}}{{/if}}
              </td>
            </tr>
          {{/each}}
        </tbody>
      </table>
    {{else}}
      <p>No contacts.</p>
    {{/if}}

    {{#if this.model.is_admin}}
      <h4>Staff</h4>
      {{#if this.model.awaiting_orders.length}}
        <p class="space-awaiting">
          Awaiting orders: {{#each this.model.awaiting_orders as |n|}}{{n}} {{/each}}
        </p>
      {{/if}}
      <button class="btn btn-sm btn-warning" {{action "resolveRound"}}>Resolve Round</button>
    {{/if}}

  </div>
</div>
