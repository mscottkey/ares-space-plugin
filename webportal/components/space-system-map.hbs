<div class="space-system-wrapper">
  <svg class="space-system-map {{if this.animate 'is-animated'}}"
       viewBox={{this.viewBox}} preserveAspectRatio="xMidYMid meet">

    <defs>
      <radialGradient id="space-star-glow">
        <stop offset="0%" stop-color="#ffd9a0" stop-opacity="0.85" />
        <stop offset="60%" stop-color="#ffd9a0" stop-opacity="0.18" />
        <stop offset="100%" stop-color="#ffd9a0" stop-opacity="0" />
      </radialGradient>
    </defs>

    {{! Presentation attributes below duplicate the stylesheet on purpose.
        CSS overrides them when custom.scss is built, and they keep the map
        readable if it isn't - an unstyled SVG circle is a solid black disc. }}

    <g class="space-system-orbits">
      {{#each this.orbitRings as |ring|}}
        <circle class="space-system-orbit" cx={{ring.cx}} cy={{ring.cy}} r={{ring.r}}
                fill="none" stroke="#b6b6c0" stroke-width="1" stroke-dasharray="3 5" />
      {{/each}}
    </g>

    <g class="space-system-star">
      <circle class="space-star-glow"
              cx={{this.system.star.x}} cy={{this.system.star.y}}
              r={{this.starGlowRadius}} fill="url(#space-star-glow)" />
      <circle class="space-star-body"
              cx={{this.system.star.x}} cy={{this.system.star.y}}
              r={{this.system.star.radius}}
              fill="#fbe0b0" stroke="#e0a44a" stroke-width="1.5">
        <title>{{this.system.star.name}} ({{this.system.star.spectral}}-class)</title>
      </circle>
    </g>

    {{! Four nested groups per body, and each one earns its place:
        1. spin      - CSS animation, rotates the whole orbit about the star
        2. start     - static transform ATTRIBUTE holding the configured angle
        3. counter   - CSS animation cancelling the spin, so labels stay level
        4. unstart   - cancels the start angle for the same reason
        The start angle is an attribute rather than a negative animation-delay
        so that bodies land in the right place even with the animation paused,
        unsupported, or - as happens - with the stylesheet not yet built.

        A moon's <g> sits INSIDE its parent's spin+start pair rather than
        as a sibling body with a star-relative angle of its own - that
        nesting is what makes it ride along with the parent instead of
        tracing its own independent circle at a bearing that has nothing
        to do with where the parent actually is. See space-system-map.js
        for why its counter-transform has to undo two angles, not one. }}

    <g class="space-system-bodies">
      {{! key="key" matters here, not just for perf: `bodies` is a
          computed() keyed to selectedKey, so every click on a body
          returns a brand-new array of brand-new objects. Without an
          explicit key, {{#each}} matches by identity, so a click would
          otherwise tear down and rebuild the WHOLE svg body tree -
          restarting every element's CSS animation from its 0% keyframe
          on every single click. }}
      {{#each this.bodies key="key" as |body|}}
        <g class="space-orbit-spin" style={{body.spinStyle}}>
          {{! This startTransform group has to wrap the moons loop below,
              not just the parent's own content - a moon nested outside
              it never receives the parent's static angle, while its own
              counter-transform keeps subtracting that angle as though it
              had. That mismatch was a real, shipped bug: it left a
              constant, uncancelled tilt on every moon's label and threw
              its position off by the same missing rotation. }}
          <g transform={{body.startTransform}}>
            <g class="space-orbit-counter" style={{body.counterStyle}}>
              <g transform={{body.counterTransform}}>
                <g class="space-system-body
                          {{if body.selected 'is-selected'}}
                          {{if body.engaged 'is-engaged'}}
                          {{if body.isBelt 'is-belt'}}"
                   role="button"
                   {{action "selectBody" body}}>

                  {{#if body.factionColor}}
                    <circle class="space-body-faction"
                            cx={{body.bodyX}} cy={{body.bodyY}}
                            r={{body.haloRadius}}
                            fill="none" stroke={{body.factionColor}}
                            stroke-width="2" stroke-opacity="0.55" />
                  {{/if}}

                  {{#if body.shipCount}}
                    <circle class="space-body-ships"
                            cx={{body.bodyX}} cy={{body.bodyY}}
                            r={{body.shipsRadius}}
                            fill="none" stroke="#3b7dd8" stroke-width="1"
                            stroke-opacity="0.7" stroke-dasharray="2 2" />
                  {{/if}}

                  {{#if body.engaged}}
                    <circle class="space-body-engaged"
                            cx={{body.bodyX}} cy={{body.bodyY}}
                            r={{body.engagedRadius}}
                            fill="none" stroke="#d9534f" stroke-width="2" />
                  {{/if}}

                  <circle class="space-body-core"
                          cx={{body.bodyX}} cy={{body.bodyY}} r={{body.size}}
                          fill={{body.fill}} stroke={{body.stroke}}
                          stroke-width="1.5" />

                  <text class="space-body-label" x={{body.bodyX}} y={{body.bodyY}}
                        dy={{body.labelDy}} text-anchor="middle"
                        font-size={{this.labelSize}} fill="#55555f">{{body.name}}</text>

                  <title>{{body.name}} &mdash; {{body.classification}}, held by {{body.faction}}{{#if body.engaged}} (ENGAGED, round {{body.round}}){{/if}}</title>
                </g>
              </g>
            </g>

            {{#each body.moons key="key" as |moon|}}
              <g transform={{moon.localTransform}}>
                <g class="space-orbit-counter" style={{moon.counterStyle}}>
                  <g transform={{moon.counterTransform}}>
                    <g class="space-system-body
                              {{if moon.selected 'is-selected'}}
                              {{if moon.engaged 'is-engaged'}}"
                       role="button"
                       {{action "selectBody" moon}}>

                      {{#if moon.factionColor}}
                        <circle class="space-body-faction"
                                cx={{moon.bodyX}} cy={{moon.bodyY}}
                                r={{moon.haloRadius}}
                                fill="none" stroke={{moon.factionColor}}
                                stroke-width="2" stroke-opacity="0.55" />
                      {{/if}}

                      {{#if moon.shipCount}}
                        <circle class="space-body-ships"
                                cx={{moon.bodyX}} cy={{moon.bodyY}}
                                r={{moon.shipsRadius}}
                                fill="none" stroke="#3b7dd8" stroke-width="1"
                                stroke-opacity="0.7" stroke-dasharray="2 2" />
                      {{/if}}

                      {{#if moon.engaged}}
                        <circle class="space-body-engaged"
                                cx={{moon.bodyX}} cy={{moon.bodyY}}
                                r={{moon.engagedRadius}}
                                fill="none" stroke="#d9534f" stroke-width="2" />
                      {{/if}}

                      <circle class="space-body-core"
                              cx={{moon.bodyX}} cy={{moon.bodyY}} r={{moon.size}}
                              fill={{moon.fill}} stroke={{moon.stroke}}
                              stroke-width="1.5" />

                      <text class="space-body-label" x={{moon.bodyX}} y={{moon.bodyY}}
                            dy={{moon.labelDy}} text-anchor="middle"
                            font-size={{this.labelSize}} fill="#55555f">{{moon.name}}</text>

                      <title>{{moon.name}} &mdash; {{moon.classification}}, held by {{moon.faction}}{{#if moon.engaged}} (ENGAGED, round {{moon.round}}){{/if}}</title>
                    </g>
                  </g>
                </g>
              </g>
            {{/each}}

            {{! Only present while the body is engaged - see
                WebData.body_map_entry's engaged_ships. Rides the body's
                own spin+start transform exactly like a moon does, just
                at a small fixed offset instead of an orbit of its own -
                see dockedShips in space-system-map.js. This is what
                fixes the reported bug for ships at a fight: previously
                every ship, engaged or not, lived in the flat
                space-system-ships layer below with no animation at
                all, so it visibly drifted off the body as the body's
                own spin carried on without it. }}
            {{#each body.dockedShips key="id" as |dship|}}
              <g transform={{dship.localTransform}}>
                <g class="space-orbit-counter" style={{dship.counterStyle}}>
                  <g transform={{dship.counterTransform}}>
                    <circle class="space-ship-marker" cx={{dship.shipX}} cy={{dship.shipY}}
                            r={{this.shipMarkerRadius}}
                            fill={{dship.color}} stroke="#ffffff" stroke-width="1.5" />
                    <text class="space-ship-label" x={{dship.shipX}} y={{dship.shipY}}
                          dy={{this.shipLabelDy}} text-anchor="middle"
                          font-size={{this.labelSize}} fill="#3a3a45">{{dship.name}}</text>
                    <title>{{dship.name}} [{{dship.faction}}]</title>
                  </g>
                </g>
              </g>
            {{/each}}
          </g>
        </g>
      {{/each}}
    </g>

    {{! A ring-anchored ship (no body under it - a capital ship staging
        between planets, or a station) gets the same four-group
        spin/start/counter/unstart structure as a lone body above, just
        ship-styled. It needs its own animated group for the same
        reason a body does: without one it would sit at a fixed point
        while the rest of the map visibly moves around it. }}
    <g class="space-system-ring-ships">
      {{#each this.ringShips key="id" as |rship|}}
        <g class="space-orbit-spin" style={{rship.spinStyle}}>
          <g transform={{rship.startTransform}}>
            <g class="space-orbit-counter" style={{rship.counterStyle}}>
              <g transform={{rship.counterTransform}}>
                <circle class="space-ship-marker" cx={{rship.bodyX}} cy={{rship.bodyY}}
                        r={{this.shipMarkerRadius}}
                        fill={{rship.color}} stroke="#ffffff" stroke-width="1.5" />
                <text class="space-ship-label" x={{rship.bodyX}} y={{rship.bodyY}}
                      dy={{this.shipLabelDy}} text-anchor="middle"
                      font-size={{this.labelSize}} fill="#3a3a45">{{rship.name}}</text>
                <title>{{rship.name}} [{{rship.faction}}]</title>
              </g>
            </g>
          </g>
        </g>
      {{/each}}
    </g>

    {{! Every ship here is under way - see the `ships` computed in
        space-system-map.js, which filters to inTransit only. A ship
        parked at a body (engaged or not) or holding in a ring is drawn
        above instead, since either one needs to sit inside an animated
        group rather than a flat, static layer. }}
    <g class="space-system-ships">
      {{#each this.ships key="id" as |ship|}}
        <line class="space-ship-course"
              x1={{ship.fromX}} y1={{ship.fromY}}
              x2={{ship.toX}} y2={{ship.toY}}
              stroke="#5a8cc8" stroke-width="1" stroke-dasharray="4 4" />
        <g class="space-system-ship is-transit">
          <circle class="space-ship-marker" cx={{ship.x}} cy={{ship.y}}
                  r={{this.shipMarkerRadius}}
                  fill={{ship.color}} stroke="#ffffff" stroke-width="1.5" />
          <text class="space-ship-label" x={{ship.x}} y={{ship.y}}
                dy={{this.shipLabelDy}} text-anchor="middle"
                font-size={{this.labelSize}} fill="#3a3a45">{{ship.name}}</text>
          <title>{{ship.name}} [{{ship.faction}}] &rarr; {{ship.destinationName}}, ETA {{ship.eta}}</title>
        </g>
      {{/each}}
    </g>
  </svg>
</div>

<div class="space-system-legend">
  {{#each this.system.legend as |item|}}
    <span class="space-legend-item">
      <svg class="space-legend-swatch" viewBox="0 0 14 14" width="14" height="14">
        <circle cx="7" cy="7" r="5" fill={{item.fill}} stroke={{item.stroke}} />
      </svg>
      {{item.label}}
    </span>
  {{/each}}
</div>
